NODE_ENV=development
PORT=3001
# With the docker-compose Mongo (single-node replica set). For a plain
# standalone mongod, drop the ?replicaSet=rs0. For Atlas, use the SRV URI.
MONGODB_URI=mongodb://localhost:27017/lyra?replicaSet=rs0
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# 32-byte (64 hex chars) key for AES-256-GCM encryption of stored provider keys (used from Phase 2)
ENCRYPTION_KEY=replace_with_64_hex_chars
# Email (password reset, etc.). Unset SMTP_HOST = dev stub (links logged to the
# console). For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password> (needs 2FA enabled —
# NOT your normal password). MAIL_FROM is the visible sender.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# MAIL_FROM=Lyra <you@gmail.com>

# Google sign-in (OAuth 2.0). Create a "Web application" OAuth client at
# console.cloud.google.com → APIs & Services → Credentials. Authorized redirect
# URI must be <WEB_ORIGIN>/auth/google/callback. Unset = the Google button is
# disabled (redirects to /login?error=google_unavailable).
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_CALLBACK_URL=   # optional override; defaults to <WEB_ORIGIN>/auth/google/callback

# Optional: route OpenAI + DeepSeek through a local LiteLLM gateway (self-hosted
# open models via Ollama, official APIs, fallbacks). Unset = official APIs direct.
# Store each workspace's LiteLLM virtual key as its openai/deepseek provider key.
# See docs/lyra-litellm-gateway.md.
# LITELLM_BASE=http://localhost:4000/v1
