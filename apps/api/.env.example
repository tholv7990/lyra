NODE_ENV=development
PORT=3001
# With the docker-compose Mongo (single-node replica set). For a plain
# standalone mongod, drop the ?replicaSet=rs0. For Atlas, use the SRV URI.
MONGODB_URI=mongodb://localhost:27017/lyra?replicaSet=rs0
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# 32-byte (64 hex chars) key for AES-256-GCM encryption of stored provider keys (used from Phase 2)
ENCRYPTION_KEY=replace_with_64_hex_chars
