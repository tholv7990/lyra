{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^archiver$": "<rootDir>/__mocks__/archiver.ts"
  },
  "setupFiles": ["<rootDir>/setup-e2e-env.ts"],
  "maxWorkers": 1,
  "testTimeout": 60000
}
